 "head_html": "<script>\n(function () {\n\tvar theme = null;\n\ttry { theme = localStorage.getItem(\"user-theme\"); } catch (error) {}\n\tif (theme !== \"light\" && theme !== \"dark\") {\n\t\ttheme = window.matchMedia(\"(prefers-color-scheme: dark)\").matches ? \"dark\" : \"light\";\n\t\t// Save it so the dashboard, which otherwise defaults to dark, opens in the same mode.\n\t\ttry { localStorage.setItem(\"user-theme\", theme); } catch (error) {}\n\t}\n\tdocument.documentElement.setAttribute(\"data-theme\", theme);\n})();\nfunction toggleBuzzTheme() {\n\tvar next = document.documentElement.getAttribute(\"data-theme\") === \"dark\" ? \"light\" : \"dark\";\n\tdocument.documentElement.setAttribute(\"data-theme\", next);\n\ttry { localStorage.setItem(\"user-theme\", next); } catch (error) {}\n}\n</script>\n<style>\n:root[data-theme=\"dark\"] .buzz-theme-moon { display: none; }\n:root[data-theme=\"light\"] .buzz-theme-sun { display: none; }\n/* buzz-theme-colors:start */\n:root { --buzz-111111-ffffff: #111111;--buzz-171717-f5f5f5: #171717;--buzz-262626-e5e5e5: #262626;--buzz-404040-d4d4d4: #404040;--buzz-737373-a3a3a3: #737373;--buzz-d4d4d4-404040: #d4d4d4;--buzz-e5e5e5-2a2a2a: #e5e5e5;--buzz-fafafa-171717: #fafafa;--buzz-ffffff-111111: #ffffff; }\n:root[data-theme=\"dark\"] { --buzz-111111-ffffff: #ffffff;--buzz-171717-f5f5f5: #f5f5f5;--buzz-262626-e5e5e5: #e5e5e5;--buzz-404040-d4d4d4: #d4d4d4;--buzz-737373-a3a3a3: #a3a3a3;--buzz-d4d4d4-404040: #404040;--buzz-e5e5e5-2a2a2a: #2a2a2a;--buzz-fafafa-171717: #171717;--buzz-ffffff-111111: #111111; }\n/* buzz-theme-colors:end */\n</style>",
