 "head_html": "<script>\n(function () {\n\tvar theme = null;\n\ttry { theme = localStorage.getItem(\"buzz-theme\"); } catch (error) {}\n\tif (theme !== \"light\" && theme !== \"dark\") {\n\t\ttheme = window.matchMedia(\"(prefers-color-scheme: dark)\").matches ? \"dark\" : \"light\";\n\t}\n\tdocument.documentElement.setAttribute(\"data-theme\", theme);\n})();\nfunction toggleBuzzTheme() {\n\tvar next = document.documentElement.getAttribute(\"data-theme\") === \"dark\" ? \"light\" : \"dark\";\n\tdocument.documentElement.setAttribute(\"data-theme\", next);\n\ttry { localStorage.setItem(\"buzz-theme\", next); } catch (error) {}\n}\n</script>\n<style>\n:root[data-theme=\"dark\"] .buzz-theme-moon { display: none; }\n:root[data-theme=\"light\"] .buzz-theme-sun { display: none; }\n</style>",
